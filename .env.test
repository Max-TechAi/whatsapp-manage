NODE_ENV=production
LOG_LEVEL=info

# Isolated test stack credentials (do not reuse production secrets)
DATABASE_URL=postgresql://whatsapp:test_db_password@postgres:5432/whatsapp_db
DB_PASSWORD=test_db_password
DB_POOL_MAX=10

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=test_redis_password

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=test_minio_access_key
MINIO_SECRET_KEY=test_minio_secret_key
MINIO_BUCKET=whatsapp-media
MINIO_USE_SSL=false

JWT_SECRET=replace-this-with-a-long-random-test-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

PORT=3000
WS_PORT=3001

RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100
RATE_LIMIT_API_KEY=300
RATE_LIMIT_WA_MESSAGES=20
WA_SEND_DELAY_MIN_MS=1000
WA_SEND_DELAY_MAX_MS=3000

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="WhatsApp Test" <no-reply@test.local>
